# ===== General =====
TZ=America/Bogota

# ===== MQTT / Maqiatto (external) =====
MQTT_BROKER_HOST=maqiatto.com
MQTT_BROKER_PORT=1883
MQTT_USER=your_maqiatto_username
MQTT_PASSWORD=replace_with_maqiatto_password
MQTT_TOPIC_BASE=<your_maqiatto_username>/fiot/garage
MQTT_COMMAND_TOPIC=<your_maqiatto_username>/fiot/garage/commands
COMMANDS_ENABLED=true

# ===== MariaDB =====
MARIADB_ROOT_PASSWORD=replace_with_strong_password
MARIADB_DATABASE=fiot_garage
MARIADB_USER=fiot_app
MARIADB_PASSWORD=replace_with_strong_password
MARIADB_HOST=mariadb
MARIADB_PORT=3306

# ===== Node identifiers =====
HARDWARE_DEVICE_ID=ESP32-GARAGE-CO-001
SIM_DEVICE_ID=SIM-GARAGE-CO-001

# ===== Node-RED flow auto import =====
NR_AUTO_IMPORT=true
NR_FORCE_IMPORT=false

# ===== Node-RED DB startup wait =====
DB_WAIT_ENABLED=true
DB_WAIT_TIMEOUT_SEC=30
DB_WAIT_INTERVAL_SEC=1

# ===== Node-RED credentials encryption =====
# Generate with: openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=replace_with_random_64_hex_secret
API_BEARER_TOKEN=replace_with_random_64_hex_token

# ===== Node-RED API / React dashboard =====
DASHBOARD_PORT=5173
API_CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:1880

